# Replace with production URL as needed
# Without '/' at the end
BASE_URL=http://localhost:8080
# Uncomment to enable CHECK_EMAIL_EXISTS crate
# This sometimes blocks legitimate emails
# CHECK_EMAIL_EXISTS=true

# Time-to-live for unverified emails. If unconfigured, it defaults to 30 minutes
TTL_HOURS = 0
TTL_MINUTES = 30
